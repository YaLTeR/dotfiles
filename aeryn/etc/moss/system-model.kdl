disable_warning #true
repositories {
    // For very careful installation of new packages...
    /-volatile {
        base-uri "https://cdn.aerynos.dev/"
        version "stream/volatile"
        priority 0
    }
    unstable {
        base-uri "https://cdn.aerynos.dev/"
        version "stream/unstable"
        priority 10
    }
    // https://github.com/YaLTeR/aeryn-yalter-recipes
    local {
        uri "file:///home/yalter/.cache/local_repo/x86_64/stone.index"
        priority 100
    }
}
packages {
    // Defaults from the GNOME installation, stripped down somewhat
    boulder
    firefox
    font-noto
    font-noto-cjk
    font-noto-emoji
    intel-microcode
    liberation-fonts-ttf
    linux-firmware
    linux-stable
    pkgset-aeryn-base
    pkgset-aeryn-base-desktop
    pkgset-aeryn-gnome-recommended
    pkgset-aeryn-utilities
    plymouth
    sof-firmware
    usbutils
    xfsprogs
    zram-generator-defaults

    // Essentials
    fish
    tmux
    git
    htop
    fzf
    gdb
    perf
    strace
    valgrind
    syncthing
    unzip
    vim
    neovim
    man-db
    wl-clipboard-rs
