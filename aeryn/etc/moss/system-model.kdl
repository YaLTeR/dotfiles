    ghostty

    // Wayland utils
    fuzzel
    waybar
    wlsunset
    hyprlock
    gamescope
    wf-recorder
    grim
    slurp
    wayland-utils
    weston-demo

    // Apps
    resources
    keepassxc
    bazaar
    dconf-editor
    vscode-bin
    pavucontrol

    // Extras
    openssh-server
    jq
    fd
    helix
    gtk-4-demos
